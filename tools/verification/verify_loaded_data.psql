-- 적재 완료 후 로컬 psql에서 실행하는 조회 전용 보고서. DB/스키마를 변경하지 않는다.
-- 실행 중인 적재가 끝난 뒤, 기존 트랜잭션이 없는 psql 세션에서 실행한다.
-- 기본 실행:
--   \i C:/kt_nd/tools/verification/verify_loaded_data.psql
-- 전체 DW/DM 총합 비교도 실행하려면 (대량 데이터 스캔으로 시간이 걸릴 수 있음):
--   \set verify_totals true
--   \i C:/kt_nd/tools/verification/verify_loaded_data.psql
-- 다시 기본 조회만 실행하려면: \set verify_totals false
-- SQL 오류로 중단되어 트랜잭션이 남으면 rollback;을 실행한다.
-- PASS/FAIL은 개별 검사 결과이며 이 파일의 종료 자체가 전체 검증 성공을 뜻하지 않는다.

\set ON_ERROR_STOP on
\if :{?verify_totals}
\else
    \set verify_totals false
\endif

begin transaction isolation level repeatable read read only;
set local statement_timeout = '30s';

\echo '1. Recent runs: inspect the latest status; old FAILED runs are historical.'
-- RUNNING 이력이 실제 Lambda 실행 중임을 보장하지는 않는다. CloudWatch로 종료 여부 확인.
select batch_id, run_type, event_date_from, event_date_to,
       status, started_at, ended_at
from audit.pipeline_run
where pipeline_name = 'content_usage_daily'
order by started_at desc, batch_id
limit 10;

\echo '2. Watermark: PASS means it matches a successful incremental batch.'
-- caught_up_through_yesterday는 참고 정보다. 목표가 과거 날짜라면 false여도 정상일 수 있다.
-- 워터마크가 없으면 초기화만 완료됐거나 증분 적재가 아직 성공하지 않은 상태다.
select w.last_successful_event_date,
       r.status as watermark_batch_status,
       r.event_date_to,
       case
           when w.pipeline_name is null then 'NO_WATERMARK'
           when r.pipeline_name = 'content_usage_daily'
                and r.run_type = 'INCREMENTAL'
                and r.status = 'SUCCEEDED'
                and r.event_date_to = w.last_successful_event_date then 'PASS'
           else 'FAIL'
       end as watermark_check,
       (current_timestamp at time zone 'Asia/Seoul')::date - 1 as yesterday_kst,
       w.last_successful_event_date >=
           (current_timestamp at time zone 'Asia/Seoul')::date - 1
           as caught_up_through_yesterday,
       w.updated_at
from (select 1) seed
left join audit.ingestion_watermark w
    on w.pipeline_name = 'content_usage_daily'
left join audit.pipeline_run r
    on r.batch_id = w.last_successful_batch_id;

\echo '3. Recorded quality checks: each successful batch needs rules and zero failures.'
-- 실패 배치의 품질 기록은 롤백될 수 있으므로 SUCCEEDED 배치와 함께 확인한다.
-- 기존 품질 SQL을 재실행하지 않는다. 기록된 결과만 조회하며 개별 규칙 누락까지 증명하지 않는다.
-- 결과가 0행이면 성공 배치가 없는 것이므로 검증 통과로 해석하지 않는다.
select r.batch_id, r.run_type, r.event_date_from, r.event_date_to,
       count(q.rule_name) as checked_rules,
       coalesce(sum(q.failed_row_count), 0) as failed_rows,
       case
           when count(q.rule_name) = 0 then 'MISSING_QUALITY_RESULTS'
           when coalesce(sum(q.failed_row_count), 0) = 0 then 'PASS'
           else 'FAIL'
       end as recorded_quality_check
from audit.pipeline_run r
left join audit.data_quality_result q on q.batch_id = r.batch_id
where r.pipeline_name = 'content_usage_daily'
  and r.status = 'SUCCEEDED'
group by r.batch_id
order by r.started_at desc, r.batch_id;

\if :verify_totals
    \echo '4. Full usage totals: all four totals must agree; this can take several minutes.'
    -- 동일 스냅샷에서 조회한다. 기본 집계 검사이며 날짜별/개별 행의 완전성을 증명하지 않는다.
    -- 운영 DW는 category 집계이므로 개인화 DW와 행 수가 다른 것은 정상이다.
    -- 가입일 이전 사용량은 제외되므로 S3 원본 행 수와 직접 비교하지 않는다.
    set local statement_timeout = '10min';
    with totals as (
        select 'dw_operations' as layer, count(*) as row_count,
               coalesce(sum(data_usage_mb), 0) as total_usage_mb
        from dw_operations.content_usage
        union all
        select 'dw_personalization', count(*), coalesce(sum(data_usage_mb), 0)
        from dw_personalization.content_usage
        union all
        select 'dm_operations_daily', count(*), coalesce(sum(total_usage_mb), 0)
        from dm_operations.daily_usage_segment
        union all
        select 'dm_personalization_daily', count(*), coalesce(sum(total_usage_mb), 0)
        from dm_personalization.customer_daily_usage
    ), baseline as (
        select total_usage_mb from totals where layer = 'dw_personalization'
    )
    select t.layer, t.row_count, t.total_usage_mb,
           t.total_usage_mb - b.total_usage_mb as difference_mb,
           case
               when not exists (select 1 from totals where row_count > 0)
                   then 'NO_USAGE_DATA'
               when t.total_usage_mb = b.total_usage_mb then 'PASS'
               else 'FAIL'
           end as total_check
    from totals t cross join baseline b
    order by t.layer;
\else
    \echo '4. Full usage totals skipped. To enable: \set verify_totals true'
\endif

rollback;
\echo 'Read-only report finished. Review the results above; no audit results were written.'

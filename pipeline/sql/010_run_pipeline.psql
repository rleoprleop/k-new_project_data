\set ON_ERROR_STOP on
\ir ../../db/schema/001_audit_landing_common.sql
\ir ../../db/schema/020_dw_operations.sql
\ir ../../db/schema/030_dw_personalization.sql
\ir ../../db/schema/040_dm_operations.sql
\ir ../../db/schema/050_dm_personalization.sql

-- 전체 교체와 일별 증분이 같은 DW/DM을 동시에 변경하지 못하게 한다.
-- 오류로 psql 연결이 종료되면 세션 advisory lock은 PostgreSQL이 자동 해제한다.
select pg_advisory_lock(hashtextextended('content_usage_daily',0));

-- 이 문장은 데이터 트랜잭션 밖에서 실행한다. 이후 COPY나 DW/DM 생성이 롤백되어도
-- RUNNING 이력이 남아 PowerShell 오류 처리기가 실패 상태로 변경할 수 있다.
select audit.start_pipeline_run(:'source_set_checksum', :'reference_date'::date) as batch_id \gset

begin;
set local pipeline.batch_id = :'batch_id';

set local pipeline.pseudonymization_key = :'pseudonymization_key';
set local pipeline.reference_date = :'reference_date';

\ir ../../db/load/010_load_landing_raw.psql
\ir ../../db/quality/010_landing_raw.sql

-- 전체 배치는 현재 상태를 완전히 교체한다. source_batch_id는 실행 계보이며
-- 더 이상 업무 키나 데이터 버전 키로 사용하지 않는다.
delete from dm_personalization.customer_usage_feature_snapshot;
delete from dm_personalization.fact_customer_daily_usage;
delete from dm_personalization.dim_customer;
delete from dm_operations.fact_daily_usage_summary;
delete from dm_personalization.dim_plan;
delete from dm_operations.dim_plan;
delete from dw_operations.user_discount;
delete from dw_operations.user_service;
delete from dw_operations.content_usage;
delete from dw_operations.bundle_composition;
delete from dw_operations.customer;
delete from dw_operations.family;
delete from dw_personalization.user_discount;
delete from dw_personalization.user_service;
delete from dw_personalization.content_usage;
delete from dw_personalization.bundle_composition;
delete from dw_personalization.customer_identity_bridge;
delete from dw_personalization.customer_profile;
delete from dw_personalization.family;
delete from dw_common.premium_family_discount_rule;
delete from dw_common.internet_bundle_discount_rule;
delete from dw_common.plan_benefit;
delete from dw_common.plan_age_benefit;
delete from dw_common.discount;
delete from dw_common.additional_service;
delete from dw_common.age_benefit;
delete from dw_common.plan;

\ir ../../db/transform/common/010_load_master.sql

\ir ../../db/transform/operations/dw/010_build.sql
\ir ../../db/transform/personalization/dw/010_build.sql
\ir ../../db/transform/operations/dm/010_build.sql
\ir ../../db/transform/personalization/dm/010_build.sql

\ir ../../db/quality/operations/dw/010_quality.sql
\ir ../../db/quality/personalization/dw/010_quality.sql
\ir ../../db/quality/operations/dm/010_quality.sql
\ir ../../db/quality/personalization/dm/010_quality.sql

update audit.pipeline_run set status='SUCCEEDED',ended_at=clock_timestamp(),error_message=null
    where batch_id=:'batch_id'::uuid;
insert into audit.ingestion_watermark(
    pipeline_name,last_successful_event_date,last_successful_batch_id)
select 'content_usage_daily',max(usage_date),:'batch_id'::uuid
from landing.raw_content_usage
where source_batch_id=:'batch_id'::uuid
having max(usage_date) is not null
on conflict(pipeline_name) do update
set last_successful_event_date=excluded.last_successful_event_date,
    last_successful_batch_id=excluded.last_successful_batch_id,
    updated_at=clock_timestamp();
commit;
select pg_advisory_unlock(hashtextextended('content_usage_daily',0));
\echo pipeline batch :batch_id succeeded
